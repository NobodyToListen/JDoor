{
  "name": "jdoor-website",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "description": "Product website for JDoor Assist.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "generate:assets": "node scripts/generate-assets.mjs",
    "check:assets": "node scripts/generate-assets.mjs --check",
    "types": "wrangler types worker-configuration.d.ts",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "tsx --test worker/*.test.ts test/*.test.mjs",
    "validate": "node scripts/validate-site.mjs",
    "preview": "node scripts/preview.mjs",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=moderate",
    "check": "npm run audit && npm run check:assets && npm run typecheck && npm test && npm run validate && npm run test:e2e && wrangler deploy --dry-run",
    "deploy": "npm run check && wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "sharp": "0.35.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "sharp": "0.35.3"
  }
}
